# ═══════════════════════════════════════════════════════════════════
# HackSphere 3.0 — Smart Energy Microgrid Environment Configuration
# Copy this file to .env and customize as needed.
# Note: The system runs autonomously with built-in fallbacks if keys are omitted.
# ═══════════════════════════════════════════════════════════════════

# App Environment (development / production)
APP_ENV=production
PORT=9000

# Optional: Zoho Catalyst QuickML Service Configuration
# If omitted or invalid, the system automatically runs the local gradient boosting regressor
QUICKML_ENDPOINT_URL=https://api.catalyst.zoho.in/quickml/v1/project/<PROJECT_ID>/endpoints/predict
QUICKML_ENDPOINT_KEY=your_catalyst_quickml_key_here
CATALYST_ORG=your_catalyst_org_here
QUICKML_ACCESS_TOKEN=

# Optional: NVIDIA NIM Multi-Model Pool Configuration
# If omitted, the Autonomous Grid Reasoning Engine executes locally with guaranteed zero downtime
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_GENERAL_KEY=your_nvidia_api_key_here
NVIDIA_GENERAL_MODEL=google/diffusiongemma-26b-a4b-it
